# Headless build: no window, no sound, no SDL. Output: cosmergon-pov-headless

ifeq ($(V),1)
	VB=''
else
	VB=@
endif

CC?=gcc
CFLAGS+=-O2 -DPOV_NO_ERROR_DIALOG -DPOV_NO_WIPE -DPOV_VIEW_ONLY -MMD -MP
LDFLAGS+=
LIBS+=-lm -lc

OBJDIR=build-headless
OUTPUT=cosmergon-pov-headless

# make -f Makefile.headless UPSTREAM_LIMITS=1 builds the original renderer limits
# (own build directory and binary), only to show what the raised limits fix.
ifeq ($(UPSTREAM_LIMITS),1)
CFLAGS+=-DPOV_UPSTREAM_LIMITS
OBJDIR=build-headless-upstream
OUTPUT=cosmergon-pov-headless-upstream
endif

# make -f Makefile.headless SANITIZE=1 builds with AddressSanitizer and UBSan (own directory and
# binary cosmergon-pov-headless-sanitize). UBSan only reports (upstream shifts negative numbers left
# in many places); tests/test_control.py fails on every report except that one class.
ifeq ($(SANITIZE),1)
CFLAGS+=-fsanitize=address,undefined -fno-omit-frame-pointer -g -O1
LDFLAGS+=-fsanitize=address,undefined
OBJDIR=build-headless-sanitize
OUTPUT=cosmergon-pov-headless-sanitize
endif

include pov_sources.mk
SRC_DOOM = $(POV_CORE) doomgeneric_headless.o
OBJS += $(addprefix $(OBJDIR)/, $(SRC_DOOM))

all: $(OUTPUT)

-include $(OBJS:.o=.d)

clean:
	rm -rf $(OBJDIR)
	rm -f $(OUTPUT)

$(OUTPUT): $(OBJS)
	@echo [Linking $@]
	$(VB)$(CC) $(CFLAGS) $(LDFLAGS) $(OBJS) -o $(OUTPUT) $(LIBS)

$(OBJS): | $(OBJDIR)

$(OBJDIR):
	mkdir -p $(OBJDIR)

# Own code: strict warnings
$(OBJDIR)/doomgeneric_headless.o: doomgeneric_headless.c
	@echo [Compiling $<]
	$(VB)$(CC) $(CFLAGS) -Wall -Wextra -c $< -o $@

$(OBJDIR)/pov_stdin.o: pov_stdin.c
	@echo [Compiling $<]
	$(VB)$(CC) $(CFLAGS) -Wall -Wextra -c $< -o $@

$(OBJDIR)/pov_control.o: pov_control.c
	@echo [Compiling $<]
	$(VB)$(CC) $(CFLAGS) -Wall -Wextra -c $< -o $@

$(OBJDIR)/pov_sky.o: pov_sky.c
	@echo [Compiling $<]
	$(VB)$(CC) $(CFLAGS) -Wall -Wextra -c $< -o $@

$(OBJDIR)/%.o: %.c
	@echo [Compiling $<]
	$(VB)$(CC) $(CFLAGS) -c $< -o $@

print:
	@echo OBJS: $(OBJS)
