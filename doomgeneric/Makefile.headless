# Headless build: no window, no sound, no SDL. Output: cosmergon-pov-headless

ifeq ($(V),1)
	VB=''
else
	VB=@
endif

CC?=gcc
CFLAGS+=-O2 -DPOV_NO_ERROR_DIALOG -DPOV_NO_WIPE -DPOV_VIEW_ONLY -MMD -MP
LDFLAGS+=
LIBS+=-lm -lc

OBJDIR=build-headless
OUTPUT=cosmergon-pov-headless

# make -f Makefile.headless UPSTREAM_LIMITS=1 builds the original renderer limits
# (own build directory and binary), only to show what the raised limits fix.
ifeq ($(UPSTREAM_LIMITS),1)
CFLAGS+=-DPOV_UPSTREAM_LIMITS
OBJDIR=build-headless-upstream
OUTPUT=cosmergon-pov-headless-upstream
endif

# make -f Makefile.headless SANITIZE=1 builds with AddressSanitizer and UBSan (own directory and
# binary cosmergon-pov-headless-sanitize). UBSan only reports (upstream shifts negative numbers left
# in many places); tests/test_control.py fails on every report except that one class.
ifeq ($(SANITIZE),1)
CFLAGS+=-fsanitize=address,undefined -fno-omit-frame-pointer -g -O1
LDFLAGS+=-fsanitize=address,undefined
OBJDIR=build-headless-sanitize
OUTPUT=cosmergon-pov-headless-sanitize
endif

SRC_DOOM = dummy.o am_map.o doomdef.o doomstat.o dstrings.o d_event.o d_items.o d_iwad.o d_loop.o d_main.o d_mode.o d_net.o f_finale.o f_wipe.o g_game.o hu_lib.o hu_stuff.o info.o i_cdmus.o i_endoom.o i_joystick.o i_scale.o i_sound.o i_system.o i_timer.o memio.o m_argv.o m_bbox.o m_cheat.o m_config.o m_controls.o m_fixed.o m_menu.o m_misc.o m_random.o p_ceilng.o p_doors.o p_enemy.o p_floor.o p_inter.o p_lights.o p_map.o p_maputl.o p_mobj.o p_plats.o p_pspr.o p_saveg.o p_setup.o p_sight.o p_spec.o p_switch.o p_telept.o p_tick.o p_user.o r_bsp.o r_data.o r_draw.o r_main.o r_plane.o r_segs.o r_sky.o r_things.o sha1.o sounds.o statdump.o st_lib.o st_stuff.o s_sound.o tables.o v_video.o wi_stuff.o w_checksum.o w_file.o w_main.o w_wad.o z_zone.o w_file_stdc.o i_input.o i_video.o doomgeneric.o pov_control.o doomgeneric_headless.o
OBJS += $(addprefix $(OBJDIR)/, $(SRC_DOOM))

all: $(OUTPUT)

-include $(OBJS:.o=.d)

clean:
	rm -rf $(OBJDIR)
	rm -f $(OUTPUT)

$(OUTPUT): $(OBJS)
	@echo [Linking $@]
	$(VB)$(CC) $(CFLAGS) $(LDFLAGS) $(OBJS) -o $(OUTPUT) $(LIBS)

$(OBJS): | $(OBJDIR)

$(OBJDIR):
	mkdir -p $(OBJDIR)

# Own code: strict warnings
$(OBJDIR)/doomgeneric_headless.o: doomgeneric_headless.c
	@echo [Compiling $<]
	$(VB)$(CC) $(CFLAGS) -Wall -Wextra -c $< -o $@

$(OBJDIR)/pov_control.o: pov_control.c
	@echo [Compiling $<]
	$(VB)$(CC) $(CFLAGS) -Wall -Wextra -c $< -o $@

$(OBJDIR)/%.o: %.c
	@echo [Compiling $<]
	$(VB)$(CC) $(CFLAGS) -c $< -o $@

print:
	@echo OBJS: $(OBJS)
